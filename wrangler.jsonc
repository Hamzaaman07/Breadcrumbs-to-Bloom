{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "breadcrumbs-to-blooms",
  "main": ".open-next/worker.js",
  // nodejs_compat is required by the OpenNext adapter — the Next.js server
  // it wraps uses Node built-ins. compatibility_date must be >= 2024-09-23
  // for those polyfills to be available.
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
